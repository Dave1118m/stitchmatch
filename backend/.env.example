# ==========================================
# StitchMatch Production Environment Template
# ==========================================

# 1. Server Environment & Ports
NODE_ENV=production
PORT=5000

# 2. Database Connection URL (MySQL / PlanetScale / Aiven / Local)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="mysql://root:password@localhost:3306/stitchmatch?schema=public"

# 3. Security & Cryptographic Secrets (Generate 64-char random strings in production)
JWT_SECRET="generate_a_random_64_character_string_here"
JWT_PHOTO_SECRET="generate_a_different_random_64_character_string_here"
JWT_EXPIRES_IN="7d"
PHOTO_TOKEN_EXPIRES=300

# 4. Allowed Frontend CORS Domains (Comma-separated for multiple domains)
# Example: "https://yourdomain.com,https://www.yourdomain.com,https://stitchmatch.vercel.app"
FRONTEND_URL="http://localhost:5173"

# 5. Public Backend API Domain (Used for generating absolute file upload URLs)
# Example: "https://api.yourdomain.com" or "https://stitchmatch-api.onrender.com"
BACKEND_URL="http://localhost:5000"

# 6. Email Notifications (Optional - SMTP Credentials)
# Leave blank to log emails to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="StitchMatch <notifications@yourdomain.com>"

# 7. Google Gemini AI (Pro Vision & Anthropometric Scanning)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

